# GAS ウェブアプリ（本番・現行版＝保険。削除しない）
GAS_WEBAPP_URL=

# Supabase（新しいデータベース）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# フロントの接続先: gas（現行・保険）| supabase（新DB）
# 本番切替までは gas のまま。Preview だけ supabase で試験
VITE_RPC_BACKEND=gas

# 写真・確定保存（Drive 継続）— Google サービスアカウント JSON を1行で
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_PHOTO_FOLDER_ID=（任意・「訪問歯科_写真」フォルダ ID）
# GOOGLE_DRIVE_DOC_FOLDER_ID=（任意・「訪問歯科_書類アーカイブ」フォルダ ID）

# 明示パス（任意）
# VITE_RPC_PATH=/api/rpc

# ローカル: .env.local に上記をコピーして値を入れる
