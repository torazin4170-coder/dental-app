# GAS ウェブアプリ（本番・現行版＝保険。削除しない）
GAS_WEBAPP_URL=

# Supabase（新しいデータベース）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# フロントの接続先: gas（現行・保険）| supabase（新DB）
# 本番切替までは gas のまま。Preview だけ supabase で試験
VITE_RPC_BACKEND=gas

# 写真ファイルは GAS_WEBAPP_URL（あなた本人の Drive）経由で保存（案 D）
# サービスアカウントは写真の新規保存には使わない（個人 Google は容量 0）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  … 任意・書類補助用
# GOOGLE_DRIVE_PHOTO_FOLDER_ID=（任意）
# GOOGLE_DRIVE_DOC_FOLDER_ID=（任意）

# 明示パス（任意）
# VITE_RPC_PATH=/api/rpc

# ローカル: .env.local に上記をコピーして値を入れる
