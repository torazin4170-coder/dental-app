# GAS ウェブアプリ（本番・現行版）
GAS_WEBAPP_URL=

# Supabase 試用版（server のみ — ブラウザに載せない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# フロントの RPC 接続先: gas（既定）| supabase
# 本番 GAS URL は gas のまま。Preview だけ supabase にすると試用版になる
VITE_RPC_BACKEND=gas

# 明示パス（任意。設定時は BACKEND より優先）
# VITE_RPC_PATH=/api/rpc

# ローカル開発: .env.local に上記をコピーして値を入れる
