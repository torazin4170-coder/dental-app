{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/gas-rpc.js": {
      "maxDuration": 120
    },
    "api/gas-check.js": {
      "maxDuration": 60
    },
    "api/rpc.js": {
      "maxDuration": 120
    },
    "api/supabase-check.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/supabase-check",
      "schedule": "0 3 * * 1"
    }
  ]
}
