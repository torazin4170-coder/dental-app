{
  "name": "visit-dental-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-gas-deploy.mjs && tsc -b && vite build",
    "predev": "node scripts/sync-gas-deploy.mjs",
    "preview": "vite preview",
    "verify:gas": "node scripts/verify-gas-connection.mjs",
    "import:supabase": "node scripts/import-sheets-to-supabase.mjs",
    "deploy:check": "node ../scripts/what-to-deploy.mjs",
    "regression:static": "node ../scripts/check-regression-guards.mjs --diff",
    "regression:e2e": "playwright test",
    "regression:e2e:install": "playwright install chromium",
    "regression": "npm run regression:static && npm run regression:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.12.2",
    "typescript": "~6.0.2",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  }
}
